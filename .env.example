# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. Server only. Never share, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Telegram bot from @BotFather
# Bot username WITHOUT the @ (for example: my_platform_bot)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# SECRET. Server only.
TELEGRAM_BOT_TOKEN=

# Public site address, for example https://my-platform.netlify.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local testing only: "true" shows a test login button (never works in production)
ALLOW_DEV_LOGIN=
