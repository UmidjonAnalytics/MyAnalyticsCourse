# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Supabase (Project Settings -> API Keys / Data API) ---
NEXT_PUBLIC_SUPABASE_URL=
# "Publishable key" (sb_publishable_...). The legacy "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (sb_secret_...). The legacy "service_role" key also works. SERVER ONLY.
SUPABASE_SECRET_KEY=

# --- Send SMS Auth Hook (Authentication -> Hooks -> Send SMS hook -> HTTPS) ---
# Looks like: v1,whsec_xxxxxxxx
SEND_SMS_HOOK_SECRET=

# --- SMS provider: "eskiz" (real SMS) or "console" (prints the code in the server log; testing only) ---
SMS_PROVIDER=eskiz
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# Sender name/number approved by Eskiz. "4546" is Eskiz's default.
ESKIZ_FROM=4546

# --- Login methods behind feature flags (true/false) ---
ENABLE_APPLE_LOGIN=false
ENABLE_FACEBOOK_LOGIN=false

# --- Admin panel host ---
# Any host starting with "admin." is the admin panel. Add extra admin hostnames here,
# comma-separated (e.g. a second Netlify site: myplatform-admin.netlify.app).
ADMIN_HOSTNAMES=

# --- VPS only (docker-compose.yml). Not needed on Netlify. ---
# Your domain without www/admin, e.g. myplatform.uz
DOMAIN=
# Email for Let's Encrypt certificate notices
ACME_EMAIL=
