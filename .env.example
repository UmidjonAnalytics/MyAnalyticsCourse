# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Supabase (Project Settings -> API Keys / Data API) ---
NEXT_PUBLIC_SUPABASE_URL=
# "Publishable key" (sb_publishable_...). The legacy "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (sb_secret_...). The legacy "service_role" key also works. SERVER ONLY.
SUPABASE_SECRET_KEY=

# --- TEST MODE: any phone number logs in with this 6-digit code, no SMS is sent. ---
# Use while building the platform. DELETE THIS LINE BEFORE REAL STUDENTS USE THE SITE.
DEV_LOGIN_CODE=123456

# --- Send SMS Auth Hook (Authentication -> Hooks -> Send SMS hook -> HTTPS) ---
# Looks like: v1,whsec_xxxxxxxx
SEND_SMS_HOOK_SECRET=

# --- SMS provider: "eskiz" (real SMS) or "console" (prints the code in the server log; testing only) ---
SMS_PROVIDER=eskiz
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# Sender name/number approved by Eskiz. "4546" is Eskiz's default.
ESKIZ_FROM=4546

# --- Login methods behind feature flags (true/false) ---
ENABLE_APPLE_LOGIN=false
ENABLE_FACEBOOK_LOGIN=false

# --- Brand ---
# Platform name shown everywhere (header, certificates, SMS text). Redeploy after changing it.
NEXT_PUBLIC_BRAND_NAME=

# --- Admin panel host ---
# Any host starting with "admin." is the admin panel. Add extra admin hostnames here,
# comma-separated (e.g. a second Netlify site: myplatform-admin.netlify.app).
ADMIN_HOSTNAMES=
# Student site address, used for "open lesson" links in the admin panel
# (e.g. https://myanalyticsplatform.netlify.app). Optional on admin.<domain>.
PUBLIC_SITE_URL=

# --- VPS only (docker-compose.yml). Not needed on Netlify. ---
# Your domain without www/admin, e.g. myplatform.uz
DOMAIN=
# Email for Let's Encrypt certificate notices
ACME_EMAIL=

# --- Payments (see README "Payments"). A provider appears at checkout only when its keys are set. ---
# Test mode: fake payment page, no money moves. DELETE BEFORE LAUNCH.
ENABLE_TEST_PAYMENTS=
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST=true
PAYME_CARD_FORM=false
PAYME_IKPU_CODE=
PAYME_PACKAGE_CODE=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
